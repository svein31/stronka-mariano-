STORE_MODE=demo
PUBLIC_ORIGIN=http://localhost:5173
API_PORT=3001
HOST=127.0.0.1
DB_PATH=var/store.sqlite
SELLER_NAME=
SELLER_EMAIL=
SELLER_ADDRESS=
RETURNS_ADDRESS=
POLICIES_APPROVED=false
POLICY_VERSION=draft-2026-09-07

# Generate these privately with npm run owner:setup. Never use VITE_ for secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
DATA_KEY=
BACKUP_KEY=

# Transactional email over SMTP; 587 requires STARTTLS, 465 uses immediate TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional private S3-compatible backup storage, separate from the application host.
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=auto
BACKUP_PATH_STYLE=false
BACKUP_INTERVAL_HOURS=24
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only the exact IP(s) of a proxy that OVERWRITES X-Real-IP; comma separated.
# Leave empty for direct localhost development.
TRUSTED_PROXIES=

# Optional HTTPS receiver accepting JSON {service, events}; no customer data.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Run npm run worker separately when external. Both processes need the same DB and env.
WORKER_MODE=embedded

# Private media outside SQLite. Empty MEDIA_BUCKET uses the local directory.
MEDIA_DIR=var/media
MEDIA_QUOTA_MB=1024
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_REGION=auto
MEDIA_PATH_STYLE=false
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=

# InPost ShipX PL courier. Sandbox is the default; no real labels without explicit opt-in.
INPOST_ENV=sandbox
INPOST_TOKEN=
INPOST_ORGANIZATION_ID=
INPOST_ALLOW_PAID_LABELS=false
