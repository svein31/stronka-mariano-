{
  "name": "handmade-trousers-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A handmade trousers workshop: React, motion and a SQLite order backend without payments.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "audit:palette": "node scripts/audit-palette.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test scripts/*.test.mjs",
    "orders": "node --env-file-if-exists=.env scripts/orders.mjs",
    "owner:setup": "node scripts/owner-setup.mjs",
    "staff:setup": "node --env-file-if-exists=.env scripts/staff-setup.mjs",
    "worker": "node --env-file-if-exists=.env scripts/worker.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup.mjs restore",
    "backup:restore-media": "node --env-file-if-exists=.env scripts/restore-media.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "13.2.0",
    "nodemailer": "10.0.1",
    "otplib": "13.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sharp": "0.35.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
